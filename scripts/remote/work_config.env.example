# 单位 Windows 远程配置（复制为 work_config.env，仅需填一项）

# 家里 Linux 的 Tailscale 主机名或 IP（二选一，在家 Linux 执行 tailscale status 查看）
# 例：lxx01  或  100.64.x.x
TAILSCALE_HOST=lxx01

# 家里 Linux 用户名
LINUX_USER=lxx

# 家里项目路径（Remote SSH 打开文件夹时用）
REMOTE_PROJECT_DIR=/home/lxx/Projects/dummyResearch

# SSH 别名（Cursor 里选这个 Host）
SSH_HOST_ALIAS=dummy-home
